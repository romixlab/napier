// Units: a word, resolved in Rust (parse::resolve_word): a whole known unit wins (`Pa`, `cd`, `ppm`, registered
// words), else a prefix symbol and a known unit (`kPa`, `mΩ`, `µF`), else an unknown word.
word_char = _{ ASCII_ALPHA | "\u{03A9}" | "\u{2126}" | "\u{00B5}" | "\u{03BC}" | "°" | "\u{2103}" }
word = { "%" | "‰" | (word_char ~ (word_char | ASCII_DIGIT)*) }
unit = { word ~ (("^" ~ integer_number) | ss_number)? }
group = { "(" ~ silent_space ~ unit_expr ~ silent_space ~ ")" ~ (("^" ~ integer_number) | ss_number)? }
// Left associative: `a/b·c` is `(a/b)·c`.
unit_expr = { (unit | group) ~ (silent_space ~ verb ~ silent_space ~ (unit | group))* }
unit_only = { SOI ~ silent_space ~ unit_expr ~ silent_space ~ EOI }
verb = { mul | div }

si_number = { SOI ~ silent_space ~ number ~ silent_space ~ (mul ~ silent_space)? ~ unit_expr? ~ silent_space ~ EOI }

// Prefixes in resistor notation (`4k7`); in units they are split off in Rust.
tera_unconditional = { "T" } // 12
giga_unconditional = { "G" } // 9
mega_unconditional = { "M" } // 6
kilo_unconditional = { "k" | "K" } // 3
milli_unconditional = { "m" }
micro_unconditional = { "u" | "\u{03BC}" | "\u{00B5}" } // -6
nano_unconditional = { "n" } // -9

// Number
number = { integer_number ~ (exponent | ("." ~ raw_number ~ exponent?) )? }
integer_number = { minus? ~ raw_number }
raw_number = { ASCII_DIGIT+ }
minus = { "-" | "\u{2212}" }
exponent = { "e" ~ integer_number }

// Operators
mul = { "*" | "\u{22C5}" | "\u{00B7}" }
div = { "/" }

// Special cases
ohm_or_r = { "Ω" | "\u{2126}" | "R" | "r" | "Ohms" | "Ohm" }
ohm_unit = { (r_prefix? ~ ohm_or_r) | r_prefix | ohm_or_r }
r_prefix = {
    kilo_unconditional | milli_unconditional | mega_unconditional |
    micro_unconditional | giga_unconditional | nano_unconditional | tera_unconditional
}
r_number = { integer_number ~ ( exponent | ("." ~ raw_number ~ exponent?) | (r_prefix ~ raw_number?) )? }
resistance = { SOI ~ silent_space? ~ r_number ~ silent_space? ~ ohm_unit? ~ silent_space? ~ EOI }

// Superscript numbers
ss_any = { ss_zero | ss_one | ss_two | ss_three | ss_four | ss_five | ss_six | ss_seven | ss_eight | ss_nine }
ss_number = { ss_minus? ~ ss_any+ }
ss_zero = { "\u{2070}" }
ss_one = { "\u{00B9}" }
ss_two = { "\u{00B2}" }
ss_three = { "\u{00B3}" }
ss_four = { "\u{2074}" }
ss_five = { "\u{2075}" }
ss_six = { "\u{2076}" }
ss_seven = { "\u{2077}" }
ss_eight = { "\u{2078}" }
ss_nine = { "\u{2079}" }
ss_minus = { "\u{207B}" }

// Manual whitespace management
silent_space = _{ " "* }
